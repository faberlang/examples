+++
locale = "la"
+++

# =============================================================================
# static-type-ascription — ∷ states a fact; ↦ performs a conversion
# =============================================================================
#
# What this example teaches:
#   • ∷ (verte) type ascription — `value ∷ type` states a type the compiler can
#     prove: a literal whose value the target holds, a lossless widening, or an
#     identity/union ascription. It is a compile-time fact, never a runtime cast.
#   • ↦ (conversio) runtime conversion — `value ↦ type` parses or coerces at run
#     time; use it whenever the result is not provable (numerus → textus,
#     textus → numerus, numerus → bivalens, lista<numerus> → lista<textus>).
#   • Numeric law (D1.11/F3) — narrowing, float precision loss, and int↔float are
#     conversions and take ↦; a ∷ the compiler cannot prove is a compile error.
#
# Syntaxes used:
#   • functio — function definition
#   • → — return type
#   • incipit — entry point
#   • fixum — immutable binding
#   • ∷ — type ascription: a provable fact (line 78)
#   • ↦ — runtime conversion (lines 54, 64, 69, 74, 83, 91, 95)
#   • ∪ — union type (line 78)
#   • nota — print
#   • valor — dynamic/any type
#   • .length() — method call on a converted result
#   • () — parenthesized expression for conversion chaining
#
# Alternate approaches (not shown):
#   • ↦ with ⊥ recovery for values that may fail — `"100" ↦ numerus ⊥ 0` supplies the fallback on failure; ∷ has no recovery because a provable fact cannot fail
#
# Anti-patterns (avoid these):
#   • Reinterpretation casts — `42 ∷ textus` asserts a fact the compiler cannot prove; convert the value with ↦ instead
#   • Chained ∷ that lose type information — each ∷ step must restate a provable fact; a chain that changes representation is a conversion
#
# Learning path:
#   Before: Stage 4: ↦ conversio operator → Stage 5: coreutils (cksum, printf with type conversion)
#   After:  Stage 11: conversio/* suite (full conversio target reference)
#
# Stage: fixture boundary, type ascription, ∷ operator reference
# Backend: stepper
# =============================================================================

# ∷ states a fact; ↦ performs a conversion

functio getData() → lista<numerus> {
    redde [1, 2, 3]
}

functio getResponse() → valor {
    redde { "body": "body" } ↦ valor
}

functio getValue() → numerus {
    redde 42
}

incipit {
    # Convert to string — numerus → textus is a runtime conversion
    fixum _ data ← 42
    fixum _ asText ← data ↦ textus
    nota asText

    # Parse to number — textus → numerus is a runtime conversion
    fixum _ input ← "100"
    fixum _ asNum ← input ↦ numerus
    nota asNum

    # Convert to boolean — numerus → bivalens is a truthiness conversion
    fixum _ value ← 1
    fixum _ asBool ← value ↦ bivalens
    nota asBool

    # Ascribe a union type to a literal — 10 is held by numerus ∪ nihil
    fixum _ maybe ← 10 ∷ numerus ∪ nihil
    nota maybe

    # Convert an element list — lista<numerus> → lista<textus>
    fixum _ raw ← getData()
    fixum _ items ← raw ↦ lista<textus>
    nota items

    # Box the dynamic result — json → valor is a runtime conversion
    fixum _ response ← getResponse()
    nota response

    # Convert a function result directly
    fixum _ result ← getValue() ↦ textus
    nota result

    # Convert in a parenthesized expression for chaining
    fixum _ len ← (data ↦ textus).length()
    nota len
}
