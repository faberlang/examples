importa ex "./box_geom" box_geom
importa ex "./bridge" bridge
importa ex "triga:math" math

genus SceneObjectGeometry {
    varia textus name
    varia numerus vertex_count
    varia numerus index_count
    varia numerus vertex_byte_count
    varia numerus index_byte_count
    varia lista<f32> vertex_payload
    varia lista<u32> index_payload
    varia math.Color color
    varia math.Box<3> bounds
}

genus SceneGeometryManifest {
    varia lista<SceneObjectGeometry> objects
}

functio add_object(lista<SceneObjectGeometry> objects, de bridge.ScenePart part) → lista<SceneObjectGeometry> {
    fixum lista<f32> ∪ nihil vp_result ← box_geom.box_vertex_payload(part.bounds, part.red, part.green, part.blue)
    si vp_result est nihil ergo redde objects

    fixum lista<f32> payload ← vp_result vel ([] ∷ lista<f32>)
    fixum lista<u32> indices ← box_geom.box_indices()

    objects.append(SceneObjectGeometry { name = part.name, vertex_count = 24, index_count = indices.length(), vertex_byte_count = payload.length() * 4, index_byte_count = indices.length() * 4, vertex_payload = payload, index_payload = indices, color = math.Color { r = part.red, g = part.green, b = part.blue }, bounds = part.bounds })
    redde objects
}

functio budapest_scene_geometry() → SceneGeometryManifest {
    varia lista<SceneObjectGeometry> objects ← vacua
    fixum lista<bridge.ScenePart> parts ← bridge.chain_bridge_parts()

    varia numerus i ← 0
    dum i < parts.length() {
        objects ← add_object(objects, parts[i])
        i ← i + 1
    }

    redde SceneGeometryManifest { objects = objects }
}
