+++
locale = "en"
+++

# Native-Faber conversion of scripta/check-gpu-workload-contracts.py (NSM-E7).
# Gate: validates the examples-owned GPU workload oracle contracts. Derives
# the rung-4 SGD trajectory (scalar linear regression — gradus math) and
# compares it to the session events and the JSON reference sidecar under the
# declared tolerance.
#
# Same decisions and exit-code contract as the Python reference: exit 0 on ok
# ("gpu workload contracts ok" to stdout), exit 1 on any validation failure
# (failure lines printed to stderr). The tolerance is validated first; a
# non-finite or negative tolerance is a single failure and the rest of the
# rung-4 checks are skipped, exactly like the Python reference.
#
# The gate reads gpu-workload/rung-4-toy-train.ref.json and
# gpu-workload/rung-4-toy-train.expected under the repository root passed as
# the first argument. The Python reference resolves these from its own
# location; the staged kernel-import source cannot self-locate, so the
# launcher carries the repo root in the argv contract instead (the same
# convention as the E5/E6 fixture launchers).
#
# Run surface (pinned): the released faber binary via `faber script`, launched
# through the check-gpu-workload-contracts launcher (FABER_BIN override).

import from "faber:json" private json
import from "faber:solum" private solum
import from "faber:processus" private processus
import from "faber:consolum" private consolum

fn close(float left, float right, float tolerance) → bool {
    return (left - right).abs() ≤ tolerance
}

fn check_rung4(string repo_root) → list<string> {
    var list<string> failures ← vacua
    const string ref_path ← repo_root + "/gpu-workload/rung-4-toy-train.ref.json"
    const string expected_path ← repo_root + "/gpu-workload/rung-4-toy-train.expected"
    const map<string, value> ref ← json.solve(solum.lege(ref_path) ↦ string) ↦ map<string, value>

    const value tolerance_value ← ref["tolerance"]
    if tolerance_value is null {
        failures.append("rung4 tolerance must be a finite non-negative number")
        return failures
    }
    const float tolerance ← tolerance_value ↦ float
    # The JSON parser rejects NaN/Infinity literals, so the self-inequality
    # arm is defensive parity for math.isfinite.
    if tolerance < 0.0 or tolerance ≠ tolerance {
        failures.append("rung4 tolerance must be a finite non-negative number")
        return failures
    }

    const map<string, value> expected ← json.solve(solum.lege(expected_path) ↦ string) ↦ map<string, value>
    const map<string, value> inputs ← ref["inputs"] ↦ map<string, value>
    const map<string, value> session ← ref["session_contract"] ↦ map<string, value>
    const list<value> events ← session["events"] ↦ list<value>

    const float x ← inputs["x"] ↦ float
    const float y ← inputs["y"] ↦ float
    const float rate ← inputs["rate"] ↦ float
    var list<float> losses ← vacua
    var list<float> weights ← vacua
    var float weight ← inputs["initial_weight"] ↦ float

    var int index ← 0
    while index < events.length() {
        const map<string, value> event ← events[index] ↦ map<string, value>
        const int step ← event["step"] ↦ int
        if step ≠ index {
            failures.append("rung4 event " + (index ↦ string) + ": step=" + (step ↦ string))
        }
        const value launch_value ← event["launch"]
        if launch_value is null {
            failures.append("rung4 event " + (index ↦ string) + ": unexpected launch None")
        } else {
            const string launch ← launch_value ↦ string
            if launch ≠ "rung4_step_kernel" {
                failures.append("rung4 event " + (index ↦ string) + ": unexpected launch '" + launch + "'")
            }
        }
        if not close(event["previous_weight"] ↦ float, weight, tolerance) {
            failures.append("rung4 event " + (index ↦ string) + ": previous_weight mismatch")
        }

        const float err ← weight * x - y
        const float loss ← err * err
        const float next_weight ← weight - rate * err * x
        losses.append(loss)
        weights.append(next_weight)

        if not close(event["loss"] ↦ float, loss, tolerance) {
            failures.append("rung4 event " + (index ↦ string) + ": loss mismatch")
        }
        if not close(event["next_weight"] ↦ float, next_weight, tolerance) {
            failures.append("rung4 event " + (index ↦ string) + ": next_weight mismatch")
        }
        weight ← next_weight
        index ← index + 1
    }

    if (inputs["steps"] ↦ int) ≠ events.length() {
        failures.append("rung4 inputs.steps does not match session event count")
    }
    const map<string, value> reference ← ref["reference"] ↦ map<string, value>
    if reference ≠ expected {
        failures.append("rung4 .expected sidecar must mirror reference oracle")
    }
    const list<value> reference_losses ← reference["losses"] ↦ list<value>
    if reference_losses.length() ≠ losses.length() {
        failures.append("rung4 reference loss count does not match session event count")
    }
    const list<value> reference_weights ← reference["weights"] ↦ list<value>
    if reference_weights.length() ≠ weights.length() {
        failures.append("rung4 reference weight count does not match session event count")
    }
    var int k ← 0
    while k < reference_losses.length() and k < losses.length() {
        if not close(reference_losses[k] ↦ float, losses[k], tolerance) {
            failures.append("rung4 reference losses do not match derived oracle")
        }
        k ← k + 1
    }
    var int j ← 0
    while j < reference_weights.length() and j < weights.length() {
        if not close(reference_weights[j] ↦ float, weights[j], tolerance) {
            failures.append("rung4 reference weights do not match derived oracle")
        }
        j ← j + 1
    }

    const map<string, value> floor ← ref["current_output_checked_floor"] ↦ map<string, value>
    const list<string> floor_claims ← ["device_training", "session_lifecycle", "optimizer_workflow", "pytorch_equivalence"]
    for from floor_claims const claim {
        if (floor[claim] ↦ int) ≠ 0 {
            failures.append("rung4 " + claim + " must remain a non-claim")
        }
    }
    const string contract ← ref["contract"] ↦ string
    if not contract.contains("PyTorch equivalence") {
        failures.append("rung4 contract must explicitly reject PyTorch equivalence")
    }
    return failures
}

main {
    const list<string> av ← processus.argumenta() ↦ list<string>
    if av.length() ≡ 0 {
        consolum.mone("usage: check-gpu-workload-contracts <repo-root>")
        processus.exi(1)
    }
    const string repo_root ← av[0] ↦ string
    const list<string> failures ← check_rung4(repo_root)
    if failures.length() ≠ 0 {
        consolum.mone("gpu workload contract failures:")
        for from failures const failure {
            consolum.mone("  - " + failure)
        }
        processus.exi(1)
    }
    print "gpu workload contracts ok"
}
