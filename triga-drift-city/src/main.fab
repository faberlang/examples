importa ex "web:web" privata web
importa ex "web:dom" privata dom
importa ex "./city" privata city
importa ex "./vehicle" privata vehicle
importa ex "./scene" privata scene
importa ex "triga:math" privata math
importa ex "triga:graph" privata graph

# ---------------------------------------------------------------------------
# Text helpers for host bridge (transform payload + one-shot geometry).
# ---------------------------------------------------------------------------

functio floats_textus(de lista<f32> values) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < values.length() {
        si i ≡ 0 {
            output ← values[i] ↦ textus
        }
        secus {
            output ← "§ §"(output, values[i] ↦ textus)
        }
        i ← i + 1
    }
    redde output
}

functio indices_textus(de lista<u32> values) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < values.length() {
        si i ≡ 0 {
            output ← values[i] ↦ textus
        }
        secus {
            output ← "§ §"(output, values[i] ↦ textus)
        }
        i ← i + 1
    }
    redde output
}

functio bivalens_textus(bivalens value) → textus {
    si value {
        redde "true"
    }
    redde "false"
}

# Object role for host multi-draw: car gets model matrix, rest identity.
functio object_role(textus name) → textus {
    si name ≡ "car" {
        redde "car"
    }
    redde "static"
}

# Encode one SceneObjectGeometry as:
#   name;role;vertex_count;index_count;v0 v1 ...;i0 i1 ...
functio object_geometry_textus(de scene.SceneObjectGeometry obj) → textus {
    redde "§;§;§;§;§;§"(obj.name, object_role(obj.name), obj.vertex_count ↦ textus, obj.index_count ↦ textus, floats_textus(obj.vertex_payload), indices_textus(obj.index_payload))
}

# Full scene blob: objects joined by '|'. Host parseSceneGeometryBlob consumes.
functio scene_geometry_blob(de scene.SceneGeometryManifest manifest) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < manifest.objects.length() {
        fixum textus piece ← object_geometry_textus((manifest.objects)[i])
        si i ≡ 0 {
            output ← piece
        }
        secus {
            output ← "§|§"(output, piece)
        }
        i ← i + 1
    }
    redde output
}

# ---------------------------------------------------------------------------
# Transform: car model (16) + chase view-projection (16) → 32 f32 payload.
# ---------------------------------------------------------------------------

functio compute_model_matrix(de vehicle.Vehicle v) → math.Matrix4 ∪ nihil {
    # Heading feeds math.camera_prorsum_planus_ex_yaw, where +yaw swings the
    # travel direction from -Z toward +X. A right-handed rotation about +Y
    # carries the car's -Z nose the other way, toward -X, so the mesh rotation
    # is the negated heading. Using +heading here yaws the body against the
    # direction of travel.
    fixum math.Euler yaw_rotation ← math.euler(0.0, math.radians_ex_gradibus(0.0 - v.heading_degrees), 0.0)
    fixum math.Quaternion ∪ nihil rotation_result ← yaw_rotation.ad_quaternionem()
    si rotation_result est nihil ergo redde nihil
    fixum math.Quaternion rotation ← math.Quaternion { x = rotation_result!.x, y = rotation_result!.y, z = rotation_result!.z, w = rotation_result!.w }
    redde math.matrix4_composita(math.vector3(v.x, v.y, v.z), rotation, math.vector3(1.0, 1.0, 1.0))
}

functio compute_view_projection(de vehicle.ChaseCamera camera, f32 aspect) → math.Matrix4 ∪ nihil {
    fixum graph.PerspectiveCamera perspective ← graph.PerspectiveCamera { base = graph.Object3D { position = math.vector3(0.0, 0.0, 0.0), rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = math.vector3(1.0, 1.0, 1.0), matrix = math.matrix4_identitas(), children = vacua, visible = verum, name = "chase" }, fov = 50.0, aspect = aspect, near = 0.1, far = 2000.0 }
    redde perspective.visus_projectio(camera.position, camera.target, math.vector3(0.0, 1.0, 0.0))
}

functio compute_frame_transform(de vehicle.Vehicle v, de vehicle.ChaseCamera camera, f32 aspect) → math.TransformPayload ∪ nihil {
    fixum math.Matrix4 ∪ nihil model_result ← compute_model_matrix(v)
    si model_result est nihil ergo redde nihil
    fixum math.Matrix4 ∪ nihil view_proj_result ← compute_view_projection(camera, aspect)
    si view_proj_result est nihil ergo redde nihil
    fixum math.Matrix4 model ← math.Matrix4 { elements = model_result!.elements }
    fixum math.Matrix4 view_proj ← math.Matrix4 { elements = view_proj_result!.elements }
    redde math.transform_payload(model, view_proj)
}

# Host bridge: publish 32-float transform each frame for updateGraphicsStorage.
functio publish_transform(dom.Element facts_element, de vehicle.Vehicle v, de vehicle.ChaseCamera camera, f32 aspect) → vacuum {
    fixum math.TransformPayload ∪ nihil payload_result ← compute_frame_transform(v, camera, aspect)
    si payload_result est nihil {
        nota nihil
        redde
    }
    dom.attr_set(facts_element, "data-transform-payload", floats_textus(payload_result!.values))
}

# One-shot geometry upload payload for host createGraphicsResources path.
functio publish_scene_geometry(dom.Element facts_element, de city.City map) → vacuum {
    fixum scene.SceneGeometryManifest manifest ← scene.greybox_scene_geometry(map, vehicle.vehicle_local_box())
    dom.attr_set(facts_element, "data-scene-geometry", scene_geometry_blob(manifest))
    dom.attr_set(facts_element, "data-scene-object-count", manifest.objects.length() ↦ textus)
}

# ---------------------------------------------------------------------------
# Controller — simulation + host bridge. No per-frame vehicle/camera/key DOM.
# ---------------------------------------------------------------------------

@ WebController {selector = "#triga-drift-city" }
functio triga_drift_city_controller(dom.Scope scope) → lista<dom.Subscription> {
    fixum dom.Element status ← dom.require(scope, ".drift-status")
    fixum dom.Element facts ← dom.require(scope, ".drift-facts")
    fixum city.City live_city ← city.drift_city()
    varia vehicle.Application live_app ← vehicle.spawn_application()
    varia numerus live_frame ← 0

    # The canvas holds a 16:9 box through `.drift-canvas` in styles/main.css,
    # so the projection aspect is constant. Window size is not canvas size and
    # must not be substituted here.
    fixum f32 canvas_aspect ← 960.0 / 540.0

    # Simulation is owned here and live at mount. Rendering and device state
    # belong to the host, which replaces these pending values only after a
    # device and scene actually exist.
    dom.attr_set(facts, "data-simulation-owner", "faber")
    dom.attr_set(facts, "data-render-status", "awaiting-host")
    dom.attr_set(facts, "data-render-gate", "pending-host-init")
    dom.attr_set(facts, "data-device-status", "unknown")
    dom.text_set(status, "simulation-running")

    # U3 geometry → host upload (one-shot)
    publish_scene_geometry(facts, live_city)
    # Initial transform for first host frame
    publish_transform(facts, live_app.vehicle, live_app.camera, canvas_aspect)

    fixum dom.Subscription frame_sub ← dom.on_frame(dom.FrameState frame → vacuum ∴ fac {
        fixum f32 delta_seconds ← frame.delta_ms / 1000.0
        live_frame ← frame.frame
        live_app ← vehicle.step_application(live_city, live_app, delta_seconds)
        publish_transform(facts, live_app.vehicle, live_app.camera, canvas_aspect)
    })

    fixum dom.Subscription keydown_sub ← dom.on_keyboard(facts, "keydown", dom.KeyboardState key → vacuum ∴ fac {
        # Reset (R): restore spawn state; re-publish transform only.
        si key.code ≡ "KeyR" {
            fixum bivalens was_focused ← live_app.input.focused
            live_app ← vehicle.spawn_application()
            si was_focused {
                live_app ← vehicle.Application { input = vehicle.apply_focus(live_app.input, verum), vehicle = live_app.vehicle, camera = live_app.camera }
            }
            publish_transform(facts, live_app.vehicle, live_app.camera, canvas_aspect)
            redde
        }
        live_app ← vehicle.Application { input = vehicle.set_key_by_code(live_app.input, key.code, verum), vehicle = live_app.vehicle, camera = live_app.camera }
    })

    fixum dom.Subscription keyup_sub ← dom.on_keyboard(facts, "keyup", dom.KeyboardState key → vacuum ∴ fac {
        live_app ← vehicle.Application { input = vehicle.set_key_by_code(live_app.input, key.code, falsum), vehicle = live_app.vehicle, camera = live_app.camera }
    })

    # on_focus reports whether the document has focus, and emits once at
    # subscribe. That arms drive input on mount and disarms it when the window
    # loses focus, so no page script has to stage-manage DOM focus.
    fixum dom.Subscription focus_sub ← dom.on_focus(facts, "focus", dom.FocusState focus → vacuum ∴ fac {
        live_app ← vehicle.Application { input = vehicle.apply_focus(live_app.input, focus.focused), vehicle = live_app.vehicle, camera = live_app.camera }
        dom.attr_set(facts, "data-input-focused", bivalens_textus(focus.focused))
    })

    fixum dom.Subscription blur_sub ← dom.on_focus(facts, "blur", dom.FocusState focus → vacuum ∴ fac {
        live_app ← vehicle.Application { input = vehicle.apply_focus(live_app.input, focus.focused), vehicle = live_app.vehicle, camera = live_app.camera }
        dom.attr_set(facts, "data-input-focused", bivalens_textus(focus.focused))
    })

    # Canvas aspect is fixed by CSS, so resize only refreshes the payload the
    # host reads for its next frame.
    fixum dom.Subscription resize_sub ← dom.on_resize(dom.ResizeState resize → vacuum ∴ fac {
        nota resize
        publish_transform(facts, live_app.vehicle, live_app.camera, canvas_aspect)
    })

    redde [frame_sub, keydown_sub, keyup_sub, focus_sub, blur_sub, resize_sub]
}
