importa ex "web:web" privata web
importa ex "web:dom" privata dom
importa ex "triga:triga" privata triga
importa ex "./city" privata city
importa ex "./vehicle" privata vehicle
importa ex "./scene" privata scene

# ---------------------------------------------------------------------------
# Text helpers for host bridge (transform payload + one-shot geometry).
# ---------------------------------------------------------------------------

functio floats_textus(de lista<f32> values) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < values.longitudo() {
        si i ≡ 0 {
            output ← values[i] ↦ textus
        } secus {
            output ← "§ §"(output, values[i] ↦ textus)
        }
        i ← i + 1
    }
    redde output
}

functio indices_textus(de lista<u32> values) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < values.longitudo() {
        si i ≡ 0 {
            output ← values[i] ↦ textus
        } secus {
            output ← "§ §"(output, values[i] ↦ textus)
        }
        i ← i + 1
    }
    redde output
}

# Object role for host multi-draw: car gets model matrix, rest identity.
functio object_role(textus name) → textus {
    si name ≡ "car" { redde "car" }
    redde "static"
}

# Encode one SceneObjectGeometry as:
#   name;role;vertex_count;index_count;v0 v1 ...;i0 i1 ...
functio object_geometry_textus(de scene.SceneObjectGeometry obj) → textus {
    redde "§;§;§;§;§;§"(
        obj.name,
        object_role(obj.name),
        obj.vertex_count ↦ textus,
        obj.index_count ↦ textus,
        floats_textus(obj.vertex_payload),
        indices_textus(obj.index_payload)
    )
}

# Full scene blob: objects joined by '|'. Host parseSceneGeometryBlob consumes.
functio scene_geometry_blob(de scene.SceneGeometryManifest manifest) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < manifest.objects.longitudo() {
        fixum textus piece ← object_geometry_textus(manifest.objects[i])
        si i ≡ 0 {
            output ← piece
        } secus {
            output ← "§|§"(output, piece)
        }
        i ← i + 1
    }
    redde output
}

# ---------------------------------------------------------------------------
# Transform: car model (16) + chase view-projection (16) → 32 f32 payload.
# ---------------------------------------------------------------------------

functio compute_model_matrix(de vehicle.Vehicle v) → triga.Matrix4 ∪ nihil {
    fixum triga.Euler yaw_rotation ← triga.euler(
        0.0 ∷ f32,
        triga.radians_ex_gradibus(v.heading_degrees),
        0.0 ∷ f32
    )
    fixum triga.Quaternion ∪ nihil rotation_result ← triga.euler_ad_quaternionem(yaw_rotation)
    si rotation_result est nihil ergo redde nihil
    fixum triga.Quaternion rotation ← triga.Quaternion {
        x = rotation_result!.x,
        y = rotation_result!.y,
        z = rotation_result!.z,
        w = rotation_result!.w
    }
    redde triga.matrix4_composita(
        triga.vector3(v.x, v.y, v.z),
        rotation,
        triga.vector3(1.0 ∷ f32, 1.0 ∷ f32, 1.0 ∷ f32)
    )
}

functio compute_view_projection(
    de vehicle.ChaseCamera camera,
    f32 aspect
) → triga.Matrix4 ∪ nihil {
    fixum triga.PerspectiveCamera perspective ← triga.PerspectiveCamera {
        base = triga.Object3D {
            position = triga.vector3(0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32),
            rotation = triga.euler(0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32),
            quaternion = triga.quaternion(0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32),
            scale = triga.vector3(1.0 ∷ f32, 1.0 ∷ f32, 1.0 ∷ f32),
            matrix = triga.matrix4_identitas(),
            children = vacua,
            visible = verum,
            name = "chase"
        },
        fov = 50.0 ∷ f32,
        aspect = aspect,
        near = 0.1 ∷ f32,
        far = 2000.0 ∷ f32
    }
    redde triga.camera_view_projection(
        perspective,
        camera.position,
        camera.target,
        triga.vector3(0.0 ∷ f32, 1.0 ∷ f32, 0.0 ∷ f32)
    )
}

functio compute_frame_transform(
    de vehicle.Vehicle v,
    de vehicle.ChaseCamera camera,
    f32 aspect
) → triga.TransformPayload ∪ nihil {
    fixum triga.Matrix4 ∪ nihil model_result ← compute_model_matrix(v)
    si model_result est nihil ergo redde nihil
    fixum triga.Matrix4 ∪ nihil view_proj_result ← compute_view_projection(camera, aspect)
    si view_proj_result est nihil ergo redde nihil
    fixum triga.Matrix4 model ← triga.Matrix4 { elements = model_result!.elements }
    fixum triga.Matrix4 view_proj ← triga.Matrix4 { elements = view_proj_result!.elements }
    redde triga.transform_payload(model, view_proj)
}

# Host bridge: publish 32-float transform each frame for updateGraphicsStorage.
functio publish_transform(
    dom.Element facts_element,
    de vehicle.Vehicle v,
    de vehicle.ChaseCamera camera,
    f32 aspect
) → vacuum {
    fixum triga.TransformPayload ∪ nihil payload_result ←
        compute_frame_transform(v, camera, aspect)
    si payload_result est nihil {
        nota nihil
        redde
    }
    dom.attr_set(facts_element, "data-transform-payload", floats_textus(payload_result!.values))
}

# One-shot geometry upload payload for host createGraphicsResources path.
functio publish_scene_geometry(
    dom.Element facts_element,
    de city.City map,
    de vehicle.Vehicle car
) → vacuum {
    fixum scene.SceneGeometryManifest manifest ←
        scene.greybox_scene_geometry(map, vehicle.vehicle_box(car))
    dom.attr_set(facts_element, "data-scene-geometry", scene_geometry_blob(manifest))
    dom.attr_set(facts_element, "data-scene-object-count", manifest.objects.longitudo() ↦ textus)
}

# ---------------------------------------------------------------------------
# Controller — simulation + host bridge. No per-frame vehicle/camera/key DOM.
# ---------------------------------------------------------------------------

@ WebController { selector = "#triga-drift-city" }
functio triga_drift_city_controller(dom.Scope scope) → lista<dom.Subscription> {
    fixum dom.Element status ← dom.require(scope, ".drift-status")
    fixum dom.Element facts ← dom.require(scope, ".drift-facts")
    fixum city.City live_city ← city.drift_city()
    varia vehicle.Application live_app ← vehicle.spawn_application()
    varia numerus live_frame ← 0
    varia f32 live_aspect ← 960.0 ∷ f32 / 540.0 ∷ f32

    # Mount-once status attrs (done_when 10)
    dom.attr_set(facts, "data-render-status", "live-direct-webgpu")
    dom.attr_set(facts, "data-render-gate", "open")
    dom.attr_set(facts, "data-simulation-owner", "faber")
    dom.attr_set(facts, "data-device-status", "active")
    dom.text_set(status, "simulation-running-gpu-active")

    # U3 geometry → host upload (one-shot)
    publish_scene_geometry(facts, live_city, live_app.vehicle)
    # Initial transform for first host frame
    publish_transform(facts, live_app.vehicle, live_app.camera, live_aspect)

    fixum dom.Subscription frame_sub ←
        dom.on_frame((dom.FrameState frame) → vacuum ∴ fac {
            fixum f32 delta_seconds ← frame.delta_ms / 1000.0 ∷ f32
            live_frame ← frame.frame
            live_app ← vehicle.step_application(live_city, live_app, delta_seconds)
            publish_transform(facts, live_app.vehicle, live_app.camera, live_aspect)
        })

    fixum dom.Subscription keydown_sub ←
        dom.on_keyboard(facts, "keydown", (dom.KeyboardState key) → vacuum ∴ fac {
            # Reset (R): restore spawn state; re-publish transform only.
            si key.code ≡ "KeyR" {
                fixum bivalens was_focused ← live_app.input.focused
                live_app ← vehicle.spawn_application()
                si was_focused {
                    live_app ← vehicle.Application {
                        input = vehicle.apply_focus(live_app.input, verum),
                        vehicle = live_app.vehicle,
                        camera = live_app.camera
                    }
                }
                publish_transform(facts, live_app.vehicle, live_app.camera, live_aspect)
                redde
            }
            live_app ← vehicle.Application {
                input = vehicle.set_key_by_code(live_app.input, key.code, verum),
                vehicle = live_app.vehicle,
                camera = live_app.camera
            }
        })

    fixum dom.Subscription keyup_sub ←
        dom.on_keyboard(facts, "keyup", (dom.KeyboardState key) → vacuum ∴ fac {
            live_app ← vehicle.Application {
                input = vehicle.set_key_by_code(live_app.input, key.code, falsum),
                vehicle = live_app.vehicle,
                camera = live_app.camera
            }
        })

    fixum dom.Subscription focus_sub ←
        dom.on_focus(facts, "focus", (dom.FocusState focus) → vacuum ∴ fac {
            live_app ← vehicle.Application {
                input = vehicle.apply_focus(live_app.input, verum),
                vehicle = live_app.vehicle,
                camera = live_app.camera
            }
        })

    fixum dom.Subscription blur_sub ←
        dom.on_focus(facts, "blur", (dom.FocusState focus) → vacuum ∴ fac {
            live_app ← vehicle.Application {
                input = vehicle.apply_focus(live_app.input, falsum),
                vehicle = live_app.vehicle,
                camera = live_app.camera
            }
        })

    fixum dom.Subscription resize_sub ←
        dom.on_resize((dom.ResizeState resize) → vacuum ∴ fac {
            si resize.width > 0 et resize.height > 0 {
                fixum f32 w ← resize.width ↦ f32
                fixum f32 h ← resize.height ↦ f32
                live_aspect ← w / h
            }
            publish_transform(facts, live_app.vehicle, live_app.camera, live_aspect)
        })

    redde [frame_sub, keydown_sub, keyup_sub, focus_sub, blur_sub, resize_sub]
}
