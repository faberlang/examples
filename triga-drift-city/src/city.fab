importa ex "triga:math" math

genus City {
    varia math.Box<3> bounds
    varia lista<math.Box<3>> roads
    varia lista<math.Box<3>> buildings
}

# A body resting on the ground as an oriented rectangle in the x/z plane.
# `centre.y` is the base; the body rises to `centre.y + height`.
genus Footprint {
    varia vector<f32, 3> centre
    varia vector<f32, 3> forward
    varia vector<f32, 3> right
    varia f32 half_length
    varia f32 half_width
    varia f32 height
}

genus SceneFacts {
    varia numerus road_count
    varia numerus building_count
    varia numerus car_count
    varia lista<math.Box<3>> road_bounds
    varia lista<math.Box<3>> building_bounds
    varia math.Box<3> car_bounds
}

functio box3(f32 min_x, f32 min_y, f32 min_z, f32 max_x, f32 max_y, f32 max_z) → math.Box<3> {
    redde math.Box<3> { minima = [min_x, min_y, min_z] ↦ vector<f32, 3>, maxima = [max_x, max_y, max_z] ↦ vector<f32, 3> }
}

functio circuit_bounds() → math.Box<3> {
    redde box3(0.0 - 28.0, 0.0, 0.0 - 22.0, 28.0, 12.0, 22.0)
}

functio circuit_roads() → lista<math.Box<3>> {
    redde [box3(-26.0 ∷ f32, 0.0, -20.0 ∷ f32, 26.0, 0.05, -12.0 ∷ f32), box3(-26.0 ∷ f32, 0.0, 12.0, 26.0, 0.05, 20.0), box3(-26.0 ∷ f32, 0.0, -12.0 ∷ f32, -18.0 ∷ f32, 0.05, 12.0), box3(18.0, 0.0, -12.0 ∷ f32, 26.0, 0.05, 12.0)]
}

functio circuit_buildings() → lista<math.Box<3>> {
    redde [box3(-16.0 ∷ f32, 0.0, -9.0 ∷ f32, -3.0 ∷ f32, 7.0, 0.0), box3(3.0, 0.0, -9.0 ∷ f32, 16.0, 10.0, 0.0), box3(-16.0 ∷ f32, 0.0, 3.0, -7.0 ∷ f32, 5.0, 9.0), box3(-4.0 ∷ f32, 0.0, 3.0, 5.0, 8.0, 9.0), box3(8.0, 0.0, 3.0, 16.0, 6.0, 9.0)]
}

functio drift_city() → City {
    redde City { bounds = circuit_bounds(), roads = circuit_roads(), buildings = circuit_buildings() }
}

functio city_collides_box(de City city, de math.Box<3> candidate) → bivalens {
    si math.box_validum(candidate) ≡ falsum {
        redde verum
    }
    si math.box_continet_capsam(city.bounds, candidate) ≡ falsum {
        redde verum
    }
    itera ex city.buildings fixum building {
        si math.box_intersecat(candidate, building) {
            redde verum
        }
    }
    redde falsum
}

# One corner of the footprint. `along` and `across` are ±1 selectors.
functio footprint_corner(de Footprint body, f32 along, f32 across) → vector<f32, 3> {
    redde [(math.x(body.centre) + (math.x(body.forward) * body.half_length) * along) + (math.x(body.right) * body.half_width) * across, math.y(body.centre), (math.z(body.centre) + (math.z(body.forward) * body.half_length) * along) + (math.z(body.right) * body.half_width) * across] ↦ vector<f32, 3>
}

functio corner_within_bounds(de Footprint body, de math.Box<3> bounds, f32 along, f32 across) → bivalens {
    fixum vector<f32, 3> corner ← footprint_corner(body, along, across)
    redde ((math.x(corner) ≥ math.x(bounds.minima) et math.x(corner) ≤ math.x(bounds.maxima)) et math.z(corner) ≥ math.z(bounds.minima)) et math.z(corner) ≤ math.z(bounds.maxima)
}

functio footprint_within_bounds(de Footprint body, de math.Box<3> bounds) → bivalens {
    si math.y(body.centre) < math.y(bounds.minima) {
        redde falsum
    }
    si math.y(body.centre) + body.height > math.y(bounds.maxima) {
        redde falsum
    }
    fixum f32 plus ← 1.0
    fixum f32 minus ← 0.0 - 1.0
    redde ((corner_within_bounds(body, bounds, plus, plus) et corner_within_bounds(body, bounds, plus, minus)) et corner_within_bounds(body, bounds, minus, plus)) et corner_within_bounds(body, bounds, minus, minus)
}

# Separating-axis test on one axis. The axis must lie in the x/z plane so the
# vertical extents stay out of the projection.
functio separated_on_axis(de Footprint body, de math.Box<3> box, de vector<f32, 3> axis) → bivalens {
    fixum vector<f32, 3> box_centre ← [(math.x(box.minima) + math.x(box.maxima)) * 0.5, 0.0, (math.z(box.minima) + math.z(box.maxima)) * 0.5] ↦ vector<f32, 3>
    fixum f32 centre_gap ← ((axis).productum(body.centre) - (axis).productum(box_centre)).abs()
    fixum f32 body_reach ← (axis).productum(body.forward).abs() * body.half_length + (axis).productum(body.right).abs() * body.half_width
    fixum f32 box_reach ← (math.x(axis).abs() * (math.x(box.maxima) - math.x(box.minima))) * 0.5 + (math.z(axis).abs() * (math.z(box.maxima) - math.z(box.minima))) * 0.5
    redde centre_gap > body_reach + box_reach
}

# Exact overlap between the oriented footprint and an axis-aligned box. Two
# convex rectangles in a plane are disjoint when any of the four face normals
# separates them, so this is exact rather than the conservative envelope an
# axis-aligned bound of the rotated body would give.
functio footprint_intersects_box(de Footprint body, de math.Box<3> box) → bivalens {
    si math.y(body.centre) + body.height ≤ math.y(box.minima) {
        redde falsum
    }
    si math.y(box.maxima) ≤ math.y(body.centre) {
        redde falsum
    }
    si separated_on_axis(body, box, [1.0, 0.0, 0.0] ↦ vector<f32, 3>) {
        redde falsum
    }
    si separated_on_axis(body, box, [0.0, 0.0, 1.0] ↦ vector<f32, 3>) {
        redde falsum
    }
    si separated_on_axis(body, box, body.forward) {
        redde falsum
    }
    si separated_on_axis(body, box, body.right) {
        redde falsum
    }
    redde verum
}

functio city_collides_footprint(de City city, de Footprint body) → bivalens {
    si footprint_within_bounds(body, city.bounds) ≡ falsum {
        redde verum
    }
    itera ex city.buildings fixum building {
        si footprint_intersects_box(body, building) {
            redde verum
        }
    }
    redde falsum
}

functio scene_facts(de City city, de math.Box<3> car_bounds) → SceneFacts {
    redde SceneFacts { road_count = city.roads.length(), building_count = city.buildings.length(), car_count = 1, road_bounds = city.roads, building_bounds = city.buildings, car_bounds = car_bounds }
}
