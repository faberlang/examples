#!/usr/bin/env bash
set -euo pipefail
# NSM-E4: native-Faber launcher for runner_artifact_claim_gate. The gate logic
# lives entirely in runner_artifact_claim_gate.fab; this entrypoint only runs
# it on the released faber binary (faber/target/debug/faber, 1.6.0-rc.1). The
# PATH `faber` (1.3.0) is never a valid execution surface. FABER_BIN overrides
# the binary.
#
# `faber script` interprets a single source only when the path is not covered
# by a faber.toml (package routing rejects kernel imports with PKG001), so the
# gate source is staged outside any package before interpretation.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FABER_BIN="${FABER_BIN:-$(cd "$HERE/../../.." && pwd)/faber/target/debug/faber}"
export FABER_BIN
if [[ ! -x "$FABER_BIN" ]]; then
    echo "runner_artifact_claim_gate: released faber binary not found: $FABER_BIN (set FABER_BIN)" >&2
    exit 1
fi
TMP="$(mktemp -d "${TMPDIR:-/tmp}/runner_artifact_claim_gate.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
cp "$HERE/runner_artifact_claim_gate.fab" "$TMP/runner_artifact_claim_gate.fab"
if "$FABER_BIN" script "$TMP/runner_artifact_claim_gate.fab" -- "$@"; then
    exit 0
else
    exit $?
fi
