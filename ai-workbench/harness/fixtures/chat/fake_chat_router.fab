+++
locale = "en"
+++

# Native-Faber conversion of
# ai-workbench/harness/fixtures/chat/fake_chat_router.py (NSM-E6).
# Hermetic fake Stage 7 chat router: reads the prompt file and emits the
# canned JSONL event stream (router-backed metadata with all-false claim
# gates, prompt, assistant message, final) byte-stable vs the Python reference
# for the same argv.
#
# Same argv contract as the Python oracle: --prompt, --out, --model-alias,
# --source, --router-model-id, --local-path, --router-label, --router-url.
#
# The released binary's script surface routes files with non-kernel imports to
# package mode (PKG001), so the false-runner-claims vocabulary is inlined here
# (verbatim from claim_gates.py via fixtures/runner_claims.py).
#
# Run surface (pinned): the released faber binary via `faber script`, launched
# through the fake_chat_router launcher (FABER_BIN override).

import from "faber:json" private json
import from "faber:solum" private solum
import from "faber:processus" private processus
import from "faber:consolum" private consolum

const list<string> FORBIDDEN_INFERENCE_CLAIMS ← [
    "faber_owned_inference",
    "owned_model_runtime",
    "general_inference",
    "llama_cpp_parity",
    "llama_cpp_equivalence",
    "llama_cpp_runtime",
    "gguf_runtime",
    "transformer_execution",
    "transformer_runtime",
    "quantized_kernel_support",
    "gpu_execution",
    "gpu_runtime",
    "gpu_runtime_claims",
    "device_logits_execution",
    "device_softmax_execution",
    "device_training",
    "public_inference",
    "public_product_release",
    "model_downloads",
    "model_blobs_in_git",
    "implicit_model_downloads",
    "implicit_model_blobs",
    "pytorch_equivalence",
]

fn value_for(list<string> args, string flag, string fallback) → string {
    const int n ← args.length()
    var int i ← 0
    while i < n {
        const string tok ← args[i] ↦ string
        if tok ≡ flag {
            if i + 1 < n {
                return args[i + 1] ↦ string
            }
            return fallback
        }
        i ← i + 1
    }
    return fallback
}

fn trim(string s) → string {
    var int start ← 0
    var int end ← s.length()
    while start < end {
        const string ch ← s.slice(start, start + 1)
        if ch ≡ " " or ch ≡ "\t" or ch ≡ "\n" or ch ≡ "\r" {
            start ← start + 1
        } else {
            break
        }
    }
    while end > start {
        const string ch ← s.slice(end - 1, end)
        if ch ≡ " " or ch ≡ "\t" or ch ≡ "\n" or ch ≡ "\r" {
            end ← end - 1
        } else {
            break
        }
    }
    return s.slice(start, end)
}

fn all_false_claims(list<string> forbidden) → string {
    var string out ← ""
    var int i ← 0
    while i < forbidden.length() {
        if i > 0 {
            out ← out + ","
        }
        out ← out + "\"" + forbidden[i] + "\":false"
        i ← i + 1
    }
    return "{" + out + "}"
}

main {
    const list<string> av ← processus.argumenta() ↦ list<string>
    const string prompt_path ← value_for(av, "--prompt", "")
    const string out_path ← value_for(av, "--out", "")
    const string model_alias ← value_for(av, "--model-alias", "")
    const string source ← value_for(av, "--source", "")
    const string router_model_id ← value_for(av, "--router-model-id", "")
    const string local_path ← value_for(av, "--local-path", "")
    const string router_label ← value_for(av, "--router-label", "")
    const string router_url ← value_for(av, "--router-url", "")
    if prompt_path ≡ "" or out_path ≡ "" or model_alias ≡ "" or source ≡ "" or router_model_id ≡ "" or local_path ≡ "" or router_label ≡ "" or router_url ≡ "" {
        consolum.mone("usage: fake_chat_router --prompt <file> --out <file> --model-alias <name> --source <name> --router-model-id <id> --local-path <path> --router-label <name> --router-url <url>")
        processus.exi(2)
    }

    const string prompt ← trim("" + (solum.lege(prompt_path) ↦ string))
    const string claims_json ← all_false_claims(FORBIDDEN_INFERENCE_CLAIMS)
    const string metadata ← "{\"event\":\"metadata\",\"model\":" + (json.pange(model_alias) ↦ string) + ",\"source\":" + (json.pange(source) ↦ string) + ",\"status\":\"router-backed\",\"runtime\":" + (json.pange(router_label) ↦ string) + ",\"router_model_id\":" + (json.pange(router_model_id) ↦ string) + ",\"router_url\":" + (json.pange(router_url) ↦ string) + ",\"local_path\":" + (json.pange(local_path) ↦ string) + ",\"claims\":" + claims_json + "}"
    solum.scribe(out_path, metadata + "\n{\"event\":\"prompt\",\"text\":" + (json.pange(prompt) ↦ string) + "}\n{\"event\":\"message\",\"role\":\"assistant\",\"text\":\"The local router is an external runtime adapter.\"}\n{\"event\":\"final\",\"finish_reason\":\"stop\"}\n")
    print "wrote §"(out_path)
}
