+++
locale = "en"
+++

# Native-Faber conversion of
# ai-workbench/harness/fixtures/embed/fake_qwen3_oracle.py (NSM-E6).
# Hermetic fake Qwen3 embedding oracle fixture: reads the texts file and emits
# the deterministic fvi-stage2 embedding artifact (one-hot 1024-dim vectors,
# one per non-empty text line). Same shapes as the Python reference; the JSON
# is emitted with sorted keys (matching Python's sort_keys=True) via
# faber:json.pange, which sorts map keys.
#
# Same argv contract as the Python oracle: --texts, --out, --model-dir,
# --model-alias, --source, --oracle-label.
#
# Run surface (pinned): the released faber binary via `faber script`, launched
# through the fake_qwen3_oracle launcher (FABER_BIN override).

import from "faber:json" private json
import from "faber:solum" private solum
import from "faber:processus" private processus
import from "faber:consolum" private consolum

fn value_for(list<string> args, string flag, string fallback) → string {
    const int n ← args.length()
    var int i ← 0
    while i < n {
        const string tok ← args[i] ↦ string
        if tok ≡ flag {
            if i + 1 < n {
                return args[i + 1] ↦ string
            }
            return fallback
        }
        i ← i + 1
    }
    return fallback
}

main {
    const list<string> av ← processus.argumenta() ↦ list<string>
    const string texts_path ← value_for(av, "--texts", "")
    const string out_path ← value_for(av, "--out", "")
    const string model_alias ← value_for(av, "--model-alias", "")
    const string source ← value_for(av, "--source", "")
    const string oracle_label ← value_for(av, "--oracle-label", "")
    if texts_path ≡ "" or out_path ≡ "" or model_alias ≡ "" or source ≡ "" or oracle_label ≡ "" {
        consolum.mone("usage: fake_qwen3_oracle --texts <file> --out <file> --model-dir <dir> --model-alias <name> --source <name> --oracle-label <name>")
        processus.exi(2)
    }

    const list<string> texts ← solum.carpe(texts_path) ↦ list<string>
    const int input_count ← texts.length()
    var list<map<string, any>> vectors ← vacua
    var int i ← 0
    while i < texts.length() {
        var list<float> values ← vacua
        const int hot ← i % 1024
        var int d ← 0
        while d < 1024 {
            if d ≡ hot {
                values.append(1.0)
            } else {
                values.append(0.0)
            }
            d ← d + 1
        }
        var map<string, any> v ← vacua
        v.put("id", i)
        v.put("text", texts[i] ↦ string)
        v.put("values", values)
        vectors.append(v)
        i ← i + 1
    }
    var list<string> diagnostics ← vacua
    diagnostics.append("vectors generated by hermetic fake Qwen3 oracle fixture")
    var map<string, any> artifact ← vacua
    artifact.put("format", "fvi-stage2")
    artifact.put("model", model_alias)
    artifact.put("source", source)
    artifact.put("status", "oracle-backed")
    artifact.put("input_count", input_count)
    artifact.put("dimensions", 1024)
    artifact.put("normalization", "l2")
    artifact.put("oracle", oracle_label)
    artifact.put("vectors", vectors)
    artifact.put("diagnostics", diagnostics)
    solum.scribe(out_path, (json.pange(artifact) ↦ string) + "\n")
    print "wrote § vectors with dimension 1024 to §"(input_count, out_path)
}
