# =============================================================================
# oracle/capture.fab — CPU-stepper capture runner for device-summa-filum
# (SFR-6)
# =============================================================================
#
# Provenance: the existing capture was produced from the then-current
# sequential reduction surface (no `filum`, no `@ nucleum`). This runner now
# uses the explicit-head form, `reducta via summa ex a apud [i] fixum s`. The
# CPU-stepper output was pinned BEFORE any device result was observed
# (S0-C convention; numeric-policy v1.0.0). The comparison applies the
# reduction-sum tolerance row; it never asserts bit-exactness.
#
# Regenerate with:
#   faber script oracle/capture.fab
# from the package directory (examples/training/device-summa-filum/).
# =============================================================================

functio column_dot_reference(tf32[32] a) → f32 {
    redde reducta via summa ex a apud [i] fixum s {
        varia f32 t ← s * 1.4140625
        redde t
    }
}

incipit {
    fixum lista<f32> flat_a ← [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25]
    fixum tf32[] seed ← vacua
    fixum tf32[32] a ← seed.strue(flat_a, [32])
    nota column_dot_reference(a)
}
