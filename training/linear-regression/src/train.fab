# =============================================================================
# train.fab — Stage E3: multi-step linear+MSE training exemplum
# =============================================================================
#
# Extends Stage E2 single-step to iterate 8 SGD steps, record a loss trace,
# and output the full trace. Uses all five ops required for honest linear+MSE:
#   MatMul (true linear layer)        — F2 landed  e7210ff5e
#   Add    (broadcast bias)           — Stage A    a459c2cdd
#   Sub    (MSE residual)             — F1 landed  bf3282bbf
#   Mul    (square error)             — Stage A    a459c2cdd
#   Mean   (reduce to scalar loss)    — Stage A    a459c2cdd
#
# Parameter layout (matches tape oracle flat slice):
#   Input:  [0.5, -1.0, 2.0, 0.75]          2×2  frozen
#   Weight: [1.25, -0.5, 0.8, 1.1]           2×2  trainable
#   Bias:   [0.2, -0.3, 0.2, -0.3]             2×2  trainable (same-shape)
#   Target: [0.25, -1.0, 1.5, 0.75]          2×2  constant
#   LR:     0.01
#
# Negative f32 literals use 0.0 - value (fractus negation would produce
# fractus, which conflicts with f32 list element type). This is a known
# radix lexical limitation tracked for cleanup.
#
# Companion ABI: linear_backward(input, weight, bias, target, nil(), 1.0)
#   → iuncta(grad_input, grad_weight, grad_bias, grad_target)
#   Discard frozen: grad_input, grad_target.
#   Update trainable: weight, bias via inline SGD step.
#
# SGD update is inlined (param -= lr * grad) because MIR-backed targets
# cannot yet import library modules like norma:optimizer.
#
# Multi-step: iterates 8 SGD steps, records loss trace, notas the trace.
#
# NOTE: Backward companion has a pre-existing runtime type error
# ("tensor receiver type mismatch: Unit") that prevents the backward+SGD
# section from executing. Once the companion generation fix lands, uncomment
# the backward+update block. The forward-pass loop infrastructure is proven
# working independently.
#
# Build: faber run -t fmir examples/training/linear-regression/
# =============================================================================

# -------------------------------------------------------------------------
# Differentiable forward: loss = mean((input·weight + bias − target)²)
# -------------------------------------------------------------------------

@ radix lane "air"
@ radix backward "linear_backward"
functio linear_loss(
    tensor<f32, [2,2]> input,
    tensor<f32, [2,2]> weight,
    tensor<f32, [2,2]> bias,
    tensor<f32, [2,2]> target
) → fractus {
    fixum tensor<f32, [2,2]> prediction ← input.matmul(weight)
    fixum tensor<f32, [2,2]> shifted    ← prediction.addita(bias)
    fixum tensor<f32, [2,2]> residual   ← shifted.subtrahe(target)
    fixum tensor<f32, [2,2]> squared    ← residual.multiplica(residual)
    redde squared.media()
}

# -------------------------------------------------------------------------
# nil() — vacuum residual for companion ABI
# -------------------------------------------------------------------------

functio nil() → vacuum {
    tacet
}

# -------------------------------------------------------------------------
# incipit — multi-step training loop: forward × 8 + backward (pending)
# -------------------------------------------------------------------------

incipit {
    # Match tape oracle initial params exactly.
    # Negative values computed as 0.0 - v to avoid fractus coercion.
    fixum lista<f32> data_input  ← [0.5,      0.0 - 1.0, 2.0,   0.75]
    fixum lista<f32> data_weight ← [1.25,     0.0 - 0.5, 0.8,   1.1]
    fixum lista<f32> data_bias   ← [0.2,      0.0 - 0.3, 0.2, 0.0 - 0.3]
    fixum lista<f32> data_target ← [0.25,     0.0 - 1.0, 1.5,   0.75]
    fixum tensor<f32, []> seed ← vacua

    fixum tensor<f32, [2,2]> input  ← seed.strue(data_input,  [2, 2])
    varia tensor<f32, [2,2]> weight ← seed.strue(data_weight, [2, 2])
    varia tensor<f32, [2,2]> bias   ← seed.strue(data_bias,   [2, 2])
    fixum tensor<f32, [2,2]> target ← seed.strue(data_target, [2, 2])

    fixum f32 lr ← 0.01
    fixum lista<numerus> shape_w ← weight.magnitudines()
    fixum lista<numerus> shape_b ← bias.magnitudines()

    fixum numerus steps ← 8
    varia lista<f32> loss_trace ← vacua

    itera ab 0‥steps fixum step {
        # Forward pass (inlined — function call inside loop triggers SEM010
        # in current compiler for tensor-returning functions).
        fixum tensor<f32, [2,2]> pred ← input.matmul(weight)
        fixum tensor<f32, [2,2]> shft ← pred.addita(bias)
        fixum tensor<f32, [2,2]> resd ← shft.subtrahe(target)
        fixum tensor<f32, [2,2]> sqrd ← resd.multiplica(resd)
        fixum f32 loss ← sqrd.media()
        loss_trace.appende(loss)

        # TODO: Uncomment when backward companion runtime type error is resolved.
        # Backward pass + SGD update currently blocked by
        # "tensor receiver type mismatch: Unit" — the companion is generated
        # but fails at execution because one argument resolves to Unit.
        #
        #   fixum _ grads ← linear_backward(input, weight, bias, target, nil(), upstream)
        #   fixum [_, gw, gb, _] ← grads
        #
        #   fixum tensor<f32, [2,2]> lr_fill_w ← seed.crea(lr, shape_w)
        #   fixum tensor<f32, [2,2]> scaled_w ← gw.multiplica(lr_fill_w)
        #   weight ← weight.subtrahe(scaled_w)
        #
        #   fixum tensor<f32, [2,2]> lr_fill_b ← seed.crea(lr, shape_b)
        #   fixum tensor<f32, [2,2]> scaled_b ← gb.multiplica(lr_fill_b)
        #   bias ← bias.subtrahe(scaled_b)
    }

    nota loss_trace
}
