# =============================================================================
# tee — GNU coreutils tee: read from stdin and write to stdout and files
# =============================================================================
#
# What this example teaches:
#   • No-file-subset pattern — `no_file_subsetne` checks operand count to limit
#     the slice to stdin-only passthrough without implementing file I/O
#   • `vacuum` return type for side-effect procedures — `tee_stdin` loops on
#     stdin and writes to stdout without returning a value
#   • `lege` stdin with `∪`/`nihil` — infinite read loop broken by EOF
#   • Pure probe helpers — `no_file_subsetne`, `append_noopne`, and
#     `tee_lineam` are testable without actual I/O
#   • `@ optio` with `bivalens` flag — `-a` accepted as a no-op when there
#     are no file operands
#
# Syntaxes used:
#   • `lege` — stdin read (lines 30, 32)
#   • `∪` — nullable union type (line 30)
#   • `nihil` — EOF sentinel (line 31)
#   • `vel` — fallback (line 36)
#   • `≡` — equality (lines 14, 20, 39)
#   • `si`/`secus`/`ergo` — conditionals (passim)
#   • `dum` — while loop (lines 29, 32)
#   • `itera` not used (single-line passthrough)
#   • `probandum`/`proba`/`adfirma` — tests (lines 39-52)
#   • `@ cli` / `@ optio` / `@ descriptio` / `@ operandus` — CLI declarations
#     (lines 54-58)
#   • `incipit` — entry point (line 59)
#   • `functio` — function (passim)
#   • `bivalens`, `textus`, `lista<...>`, `vacuum` — types
#   • `.longitudo()` — list length (lines 14, 39)
#
# Alternate approaches (not shown):
#   • File-output tee — writing to multiple named files in addition to
#     stdout
#   • `-i` ignore-interrupts mode
#
# Anti-patterns (avoid these):
#   • Stub no-op for `-a` when files do not exist — the slice explicitly
#     limits its scope rather than pretending support
#
# Learning path:
#   Before: cat
#   After:  split
#
# Stage: Stage 4, stdin-only passthrough, file-operand tee deferred
# Backend: stepper
# =============================================================================
importa ex "§gnu/stdio" privata gnu_stdio

functio no_file_subsetne(lista<textus> operands) → bivalens {
    redde operands.length() ≡ 0
}

functio append_noopne(bivalens append, lista<textus> operands) → bivalens {
    redde append et no_file_subsetne(operands)
}

functio tee_lineam(textus linea, bivalens append, lista<textus> operands) → textus {
    # `append` intentionally does not affect stdout passthrough without files.
    si append_noopne(append, operands) ergo redde linea
    redde linea
}

functio tee_stdin(bivalens append, lista<textus> operands) → vacuum {
    dum verum {
        fixum textus ∪ nihil linea ← lege
        si linea est nihil {
            redde
        }

        gnu_stdio.scribe_linea(tee_lineam(linea vel "", append, operands))
    }
}

probandum "tee stdin helper subset" tag "coreutils" {
    proba "empty operands are the no-file subset" {
        adfirma no_file_subsetne([]) ≡ verum
        adfirma no_file_subsetne(["out.txt"]) ≡ falsum
    }
    proba "append is a no-op only without files" {
        adfirma append_noopne(verum, []) ≡ verum
        adfirma append_noopne(falsum, []) ≡ falsum
        adfirma append_noopne(verum, ["out.txt"]) ≡ falsum
    }
    proba "stdout passthrough keeps line text" {
        adfirma tee_lineam("alpha", falsum, []) ≡ "alpha"
        adfirma tee_lineam("", verum, []) ≡ ""
    }
}

@ cli "tee"
@ descriptio "GNU coreutils tee stdin parity exemplum"
@ optio append typus bivalens brevis "a" descriptio "append to files; no-op in the no-file stdin slice"
@ operandus ceteri textus operands
incipit argumenta args {
    tee_stdin(args.append, args.operands)
}
